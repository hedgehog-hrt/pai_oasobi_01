{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "record_type": {
          "const": "request"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "robot_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_seq": {
          "type": "integer",
          "minimum": 0
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1
        },
        "scheduled_ns": {
          "type": "integer",
          "minimum": 0
        },
        "sent_ns": {
          "type": "integer",
          "minimum": 0
        },
        "finished_ns": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000.0
        },
        "status": {
          "enum": [
            "ok",
            "timeout",
            "rejected",
            "error",
            "cancelled"
          ]
        },
        "valid_output": {
          "type": "boolean"
        },
        "warmup": {
          "type": "boolean"
        },
        "batch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_batch_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "slot_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "plan_request_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "robot_id",
        "episode_id",
        "request_id",
        "component_id",
        "attempt_id",
        "observation_seq",
        "clock_domain",
        "scheduled_ns",
        "sent_ns",
        "finished_ns",
        "deadline_ms",
        "status",
        "valid_output",
        "warmup",
        "batch_id",
        "actual_batch_size",
        "slot_index",
        "plan_request_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "record_type": {
          "const": "action"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "robot_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "boolean"
        },
        "executed_steps": {
          "type": "integer",
          "minimum": 0
        },
        "safety_stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "record_type",
        "run_id",
        "robot_id",
        "episode_id",
        "request_id",
        "component_id",
        "clock_domain",
        "action_id",
        "start_ns",
        "end_ns",
        "applied",
        "executed_steps",
        "safety_stopped"
      ],
      "additionalProperties": false
    }
  ]
}
